<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherited_view_move_form" model="ir.ui.view">
        <field name="name">account.move.view.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_id']" position="attributes">
                <attribute name='string'>Service</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='quantity']" position="attributes">
                <attribute name='column_invisible'>1</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='name']" position="attributes">
                <attribute name='string'>Description</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']//tree//field[@name='product_id']" position="before">
                <field name="sequence" string='Serial No'/>
            </xpath>
        </field>
    </record>
</odoo>