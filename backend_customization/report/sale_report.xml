<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="inherit_report_saleorder_document" inherit_id="sale.report_saleorder_document">
        <xpath expr="//h2[@class='mt-4']" position="replace">
            <h4 class="mt-4">
                <span t-if="env.context.get('proforma', False) or is_pro_forma">Pro-Forma Invoice # </span>
                <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
                <span t-else="">Order # </span>
                <span t-field="doc.name">SO0000</span>
            </h4>
        </xpath>
        <xpath expr="//table//thead//th[@name='th_priceunit']" position="replace">
            <th name="th_priceunit" class="text-end">Price</th>
        </xpath>
        <xpath expr="//table//thead//th[@name='th_quantity']" position="replace">
        </xpath>
        <xpath expr="//table//tbody[@class='sale_tbody']//td[@name='td_quantity']" position="replace">
        </xpath>
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_no" class="text-start"><span>Serial No</span></th>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="before">
            <th name="td_no" class="text-start"><span><t t-esc='line.sequence'/></span></th>
        </xpath>
    </template>
</odoo>