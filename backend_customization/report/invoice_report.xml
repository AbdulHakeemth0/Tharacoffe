    <template id="inherit_report_invoice_document" inherit_id="account.report_invoice_document">
    <xpath expr="//div[@name='address_not_same_as_shipping']" position="replace">
        <div style="margin-left: -670px; padding-left: -220px; margin-top: -10px;font-size: 20px;">
            <!-- Billing Address Section -->
            <div class="billing-address">
                <strong>Billing Address:</strong>
                <address class="mb-0" t-field="o.partner_id"
                         t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                <div t-if="o.partner_id.vat" id="partner_vat_address">
                    <t t-if="o.company_id.account_fiscal_country_id.vat_label"
                       t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat" />
                </div>
            </div>

        </div>
         <div class="row" style="margin-top: -10px; ">
                <div class="shipping-address" style="margin-left: -300px; padding-left: -260px;font-size: 20px;">
                    <strong>Shipping Address:</strong>
                    <address class="mb-0" t-field="o.partner_shipping_id"
                             t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                </div>
            </div>
    </xpath>

<!--        <xpath expr="//div[@name='address_same_as_shipping']" position="replace">-->
<!--            <div class="offset-col-6 col-6" name="address_same_as_shipping">-->
<!--                <t t-set="address">-->
<!--                    <strong>Billing Address:</strong>-->
<!--                    <address class="mb-0" t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}' />-->
<!--                    <div t-if="o.partner_id.vat" id="partner_vat_address_same_as_shipping">-->
<!--                        <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label" id="inv_tax_id_label" />-->
<!--                        <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat" />-->
<!--                    </div>-->
<!--                </t>-->
<!--            </div>-->

<!--        </xpath>-->
        <xpath expr="//div[@class='mt-5 clearfix']" position="attributes">
            <attribute name="class">mt-2 clearfix</attribute>
        </xpath>
        <xpath expr="//div[@id='informations']" position="replace">
            <div id="informations" class="row mt-3 mb-1">
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_date" name="invoice_date">
                    <t t-if="o.move_type == 'out_invoice'"><strong>Invoice Date:</strong></t>
                    <t t-elif="o.move_type == 'out_refund'"><strong>Credit Note Date:</strong></t>
                    <t t-elif="o.move_type == 'out_receipt'"><strong>Receipt Date:</strong></t>
                    <t t-else=""><strong>Date:</strong></t><br />
                    <span t-field="o.invoice_date">2023-09-12</span>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'" name="due_date">
                    <strong>Due Date:</strong><br />
                    <span t-field="o.invoice_date_due">2023-10-31</span>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.delivery_date" name="delivery_date">
                    <strong>Delivery Date:</strong><br />
                    <span t-field="o.delivery_date">2023-09-25</span>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.partner_id.ref" name="customer_code">
                    <strong>Customer Code:</strong><br />
                    <span t-field="o.partner_id.ref" />
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.ref" name="reference">
                    <strong>Reference:</strong><br />
                    <span t-field="o.ref">INV/2023/00001</span>
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.invoice_incoterm_id" name="incoterm_id">
                    <strong>Incoterm:</strong><br />
                    <p t-if="o.incoterm_location">
                        <span t-field="o.invoice_incoterm_id.code" /><br/>
                        <span t-field="o.incoterm_location"/>
                    </p>
                    <span t-else="" t-field="o.invoice_incoterm_id.code" class="m-0" />
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.state_id">
                    <strong>State:</strong><br/>
                    <t t-esc="o.state_id.name" />
                </div>
                <div t-attf-class="#{'col-auto col-4 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.transportation_mode">
                    <strong>Transportation Mode:</strong><br/>
                    <span t-field="o.transportation_mode" />
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.vehicle_no">
                    <strong>Vehicle No:</strong><br />
                    <span t-field="o.vehicle_no" />
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.date_supply">
                    <strong>Date of Supply:</strong><br />
                    <span t-field="o.date_supply" />
                </div>
                <div t-attf-class="#{'col-auto col-3 mw-100' if report_type != 'html' else 'col'} mb-2" t-if="o.place_dispatch">
                    <strong>Place of Dispatch:</strong><br/>
                    <span t-field="o.place_dispatch" />
                </div>
            </div>
        </xpath>
        <xpath expr="//table[@name='invoice_line_table']" position="replace">
            <table class="table table-sm o_main_table table-borderless" name="invoice_line_table">
                <thead>
                    <tr>
                        <th name="th_description" class="text-start"><span>Sr No</span></th>
                        <th name="th_description" class="text-start"><span>Product</span></th>
                        <th name="th_description" class="text-start"><span>HS No</span></th>
                        <th name="th_quantity" class="text-start"><span>Quantity</span></th>
                        <th name="th_quantity" class="text-start"><span>UOM</span></th>
                        <th name="th_priceunit" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>Rate</span></th>
                        <th name="th_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                            <span>Disc.%</span>
                        </th>
                        <th name="th_subtotal" class="text-start">
                            <span>Amount</span>
                        </th>
                        <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>CGST Rate</span></th>
                        <th name="th_taxes" t-attf-class="text-start {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"><span>SGST Rate</span></th>
                        <th name="th_subtotal" class="text-start">
                            <span>Tax Amount</span>
                        </th>
                        <th name="th_subtotal" class="text-start">
                            <span>Total</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="invoice_tbody">
                    <t t-set="current_subtotal" t-value="0" />
                    <t t-set="current_total" t-value="0" />
                    <t t-set="lines" t-value="o.invoice_line_ids.sorted(key=lambda l: (-l.sequence, l.date, l.move_name, -l.id), reverse=True)" />
                     <t t-set="sequence" t-value="1" />
                    <t t-foreach="lines" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" />
                        <t t-set="current_total" t-value="current_total + line.price_total" />
                        <tr t-att-class="'bg-200 fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <td name="td_quantity">
                                 <span t-out="sequence"/>
                                        <t t-set="sequence" t-value="sequence + 1"/>
                            </td>
                            <t t-if="line.display_type == 'product'" name="account_invoice_line_accountable">
                                <td name="account_invoice_line_name"><span t-if="line.name" t-field="line.name" t-options="{'widget': 'text'}">Bacon Burger</span></td>
                                <td name="td_quantity">
                                    <span t-field="line.hs_no"></span>
                                </td>
                                <td name="td_quantity">
                                    <span t-field="line.quantity">3.00</span>
                                </td>
                                <td name="td_quantity">
                                    <span t-field="line.product_uom_id" groups="uom.group_uom">units</span>
                                </td>
                                <td name="td_price_unit" t-attf-class=" {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span class="text-nowrap" t-field="line.price_unit">9.00</span>
                                </td>
                                <td name="td_discount" t-if="display_discount" t-attf-class="text-end {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}">
                                    <span class="text-nowrap" t-field="line.discount">0</span>
                                </td>
                                <t t-set="split_taxes" t-value="line.tax_ids.filtered(lambda l: l.split_tax)" />
                                <t t-set="simple_taxes" t-value="line.tax_ids" />
                                <td name="td_subtotal" class="text">
                                    <span class="text-nowrap" t-field="line.price_subtotal">27.00</span>
                                </td>
                                <t t-if="split_taxes">
                                    <t t-set="split_tax_percentage" t-value="sum(split_taxes.mapped('amount')) / 2"/>
                                    <td name="td_taxes" class="text-center">
                                        <span t-out="split_tax_percentage" id="line_tax_ids"/><span>%</span>
                                    </td>
                                    <td name="td_taxes" class="text-center">
                                        <span t-out="split_tax_percentage" id="line_tax_ids"/><span>%</span>
                                    </td>
                                </t>
                                <t t-else="">
                                    <td name="td_taxes" class="text-center">
                                        <span>0%</span>
                                    </td>
                                    <td name="td_taxes" class="text-center">
                                        <t t-if="simple_taxes">
                                            <t t-set="tax_percentage" t-value="sum(simple_taxes.mapped('amount'))"/>
                                            <span t-out="tax_percentage" id="line_tax_ids"/><span>%</span>
                                        </t>
                                    </td>
                                </t>
                                <td >
                                    <span t-out="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>31.05</span>
                                </td>
                                <td name="td_subtotal" class="text">
                                    <span class="text-nowrap" t-field="line.price_total">27.00</span>
                                </td>
                            </t>
                            <t t-elif="line.display_type == 'line_section'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}">A section title</span>
                                </td>
                                <t t-set="current_section" t-value="line" />
                                <t t-set="current_subtotal" t-value="0" />
                            </t>
                            <t t-elif="line.display_type == 'line_note'">
                                <td colspan="99">
                                    <span t-field="line.name" t-options="{'widget': 'text'}">A note, whose content usually applies to the section or product above.</span>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or lines[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-end">
                                <td colspan="99">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-out="current_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'>31.05</span>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>
        </xpath>
        <xpath expr="//div[@id='total']" position="after">
            <img src="backend_customization/static/src/img/Qrcode.png" alt="QR Code" width="650" height="835" style=" margin-top: 50px;"/>
            <h5 style="border-top: 2px solid;"></h5>
            <h5 style="text-align: center;"><b>Authorized Signature</b></h5>
            <!-- <img style="margin-right: auto;margin-left: auto;display: block;" class="mt-5" t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', o.name, 130, 130)" /> -->
        </xpath>
        <xpath expr="//div[@id='payment_term']" position="replace">
            <div id="payment_term" class="clearfix">
                <div t-attf-style="#{'text-align:justify;text-justify:inter-word;' if o.company_id.terms_type != 'html' else ''}" name="comment">
                    <h4 style="color:#444445;font-size: 23px;"><b>Amount In Words</b></h4>
                    <p>
                        <t t-esc="o.currency_id.amount_to_text(o.amount_total)" />
                    </p>


                </div>
                <br></br>
                <br></br>
                <div>
                    <h4 style="color:#444445; font-size: 25px; font-weight: bold;">
                       Bank Details
                   </h4>
                    <t t-if="o.partner_id.bank_ids">
                        <t t-set="bank" t-value="o.partner_id.bank_ids[0]"/>
                        <div class="mt-2">
                            <p style="margin: 2px 0;  font-size: 20px;">Bank Name:
                                <t t-esc="bank.bank_id.name"/>
                            </p>
                            <p style="margin: 2px 0; font-size: 20px;">Bank Account No.:
                                <t t-esc="bank.acc_number"/>
                            </p>
                            <p style="margin: 2px 0; font-size: 20px;">Bank IFSC code:
                                <t t-esc="bank.bank_id.bic"/>
                            </p>
                            <p style="margin: 2px 0; font-size: 20px;">Account holder's name:
                                <t t-esc="bank.acc_holder_name"/>
                            </p>
                        </div>
                    </t>
                </div>
<!--                <div class="mb-3" t-attf-style="#{'text-align:justify;text-justify:inter-word;' if o.company_id.terms_type != 'html' else ''}" t-if="not is_html_empty(o.narration)" name="comment">-->
                <br></br>
                <br></br>
                <br></br>
                <br></br>
                <div>
                    <h4 style="color:#444445;font-size: 30px;">Terms and Conditions</h4>
                    <p>1.Payment is due[number of days,eg.,30 days]from the date of Invoice.</p><br></br>
                    <p>2.A late fee of [percentage, eg,1.5%]per month will be applied to overdue amounts.</p><br></br>
                    <p>Accepted Payment Methods.</p><br></br>
                    <p>3.Payments can be made via[accepted methods, eg, bank transfer,creditcard,PayPal]</p><br></br>
                    <p>4.Provide necessary banking information if applicable</p><br></br>
                </div>
            </div>
        </xpath>
    </template>


</odoo>
