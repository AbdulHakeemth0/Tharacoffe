<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="expense_report_new">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
        <t t-call="web.external_layout">
            <div class="page">
                <h2 style="text-align: center;">Expense Report</h2>
                <table class="table" style="width:100%; border-collapse: collapse; border:2px solid black;">
                    <tr>
                        <th style="border: 2px solid black; text-align: left;">Employee Name</th>
                        <td style="border: 2px solid black;">
                            <span t-field="doc.employee_id.name"/>
                        </td>
                    </tr>
                </table>
                <table class="table" style="width:100%; border-collapse: collapse; border:2px solid black;">
                    <thead>
                        <tr>
                            <th style="border: 2px solid black;">Date</th>

                            <th style="border: 2px solid black;">Description</th>
                            <th style="border: 2px solid black;">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-if="doc.extra_expense_ids">
                            <t t-foreach="doc.extra_expense_ids" t-as="expense_line">
                                <tr>
                                    <td style="border: 2px solid black;">
                                        <span t-field="expense_line.date"/>
                                    </td>

                                    <td style="border: 2px solid black;">
                                        <span t-field="expense_line.description"/>
                                    </td>
                                    <td style="border: 2px solid black;">
                                        <span t-field="expense_line.amount"/>
                                    </td>
                                </tr>
                            </t>
                            <tr>
                                <th colspan="2" style="border: 2px solid black; text-align: right;">
                                    <span>Total</span>
                                </th>
                                <td style="border: 2px solid black;">
                                    <span t-field="expense_line.contract_id.total_allowance"/>
                                </td>
                            </tr>
                        </t>
                        <t t-else="">
                            <tr>
                                <td colspan="3" style="border: 2px solid black; text-align: center;">
                                    No expenses found.
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </t>
        </t>
    </t>
</template>






</odoo>
