<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_applicant_agent_views" model="ir.ui.view">
        <field name="name">hr.applicant.agent.views</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_id']" position="after">
                <field name="is_agent" invisible="1"/>
                <field name="agent_id" invisible="not is_agent"/>
                <field name="agent_city" invisible="1" force_save="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_hr_applicant_search_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.search.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_search_bis"/>
        <field name="arch" type="xml">
           <xpath expr="//filter[@name='company']" position="after">
                <filter string="Agent Location" name="agent_location" context="{'group_by': 'agent_city'}"/>
            </xpath>
        </field>
    </record>
</odoo>
