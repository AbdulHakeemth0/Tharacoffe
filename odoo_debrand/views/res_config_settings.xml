<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_odoo" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.odoo.debrand</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='companies']" position="after">
                <block title="Odoo Debrand" name="odoo_debrand">
                    <setting id="odoo_title" string="Title">
                        <field name="odoo_title" />
                    </setting>
                    <setting id="odoo_favicon" string="Favicon">
                        <field name="odoo_favicon" widget="image" class="float-start oe_avatar"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>