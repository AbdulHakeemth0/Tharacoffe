<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension">

        <xpath expr="//div[hasclass('closing-notes-container')]" position="after">
            <t t-if="pos.config.cash_control">
                <p>Cash for Counter</p>
                <Input tModel="[state.payments[props.default_cash_details.id], 'cash_for_counter']"
                       callback.bind="(value) =>  this.setManualCashInput(value)"
                       isValid.bind="env.utils.isValidFloat"/>
            </t>
        </xpath>

        <xpath expr="//div[hasclass('total-orders')]" position="replace">
            <div class="total-orders fw-bolder">
                    Total <t t-esc="props.orders_details.quantity"/>
                orders
                <span class="amount d-none" t-esc="env.utils.formatCurrency(props.orders_details.amount)"/>
                </div>
        </xpath>

        <xpath expr="//tbody[hasclass('cash-overview')]" position="replace">
        </xpath>

        <xpath expr="//tbody[@t-if='props.other_payment_methods.length > 0']" position="replace">
        </xpath>

        <xpath expr="//tr[hasclass('text-dark')]/th[2]" position="replace">
            <th class="d-none">Expected</th>
        </xpath>
        <xpath expr="//t[@t-if='pos.config.cash_control']/tbody/tr/td[2]" position="replace">
            <td t-esc="env.utils.formatCurrency(props.default_cash_details.amount)" class="d-none"/>
        </xpath>

        <xpath expr="//tr[hasclass('text-dark')]/th[4]" position="replace">
            <th class="d-none">Difference</th>
        </xpath>
        <xpath expr="//t[@t-if='pos.config.cash_control']/tbody/tr/td[4]" position="replace">
            <td t-esc="env.utils.formatCurrency(getDifference(props.default_cash_details.id))"
                t-att-class="{'warning text-danger fw-bolder': !env.utils.floatIsZero(getDifference(props.default_cash_details.id))}"
                class="d-none"/>
        </xpath>
    </t>
</templates>
