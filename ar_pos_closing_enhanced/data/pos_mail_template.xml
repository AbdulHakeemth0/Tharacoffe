<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_template_pos_closing_bal_mail" model="mail.template">
        <field name="name">Mail: POS Closing Balance Mail Template</field>
        <field name="model_id" ref="point_of_sale.model_pos_session"/>
        <field name="email_from">"{{ object.company_id.name }}" &lt;{{ (object.company_id.email or user.email) }}&gt;
        </field>
        <field name="email_to">{{ object.higher_authority.email }}</field>
        <field name="body_html" type="html">
            <div>Hello </div>
        </field>
    </record>
</odoo>
