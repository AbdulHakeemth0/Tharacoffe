<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_session_form_closing_details" model="ir.ui.view">
        <field name="name">view.pos.session.form.closing.details</field>
        <field name="model">pos.session</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cash_register_balance_start']" position="after">
                <field name="cash_for_counter"/>
            </xpath>
        </field>
    </record>
</odoo>
