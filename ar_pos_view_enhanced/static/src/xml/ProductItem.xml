<?xml version="1.0" encoding="UTF-8"?>
<!--inherited to add quantity in  each product card-->
<templates id="template" xml:space="preserve">
    <t t-name="point_of_sale.CategorySelector" t-inherit="point_of_sale.CategorySelector"
       t-inherit-mode="extension">
        <xpath expr="//div/div/button/span"
               position="replace">
            <span t-if="category.name" class="w-100 text-center fs-5 inline-block" t-esc="category.name"
                  style="min-height: 1.2rem"/>
        </xpath>
    </t>

    <t t-name="point_of_sale.TicketScreen" t-inherit="point_of_sale.TicketScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('header-row')]//div[@class='col end p-2'][text()='Total']" position="replace">
            <div class="col end p-2 d-none">Total</div>
        </xpath>
         <xpath expr="//div[hasclass('order-row')]//div[@class='col end p-2']" position="replace">
             <div class="col end p-2 d-none">
                <div><t t-esc="getTotal(order)"></t></div>
            </div>
        </xpath>
    </t>

</templates>
